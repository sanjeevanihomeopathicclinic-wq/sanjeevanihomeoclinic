# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Google Service Account ────────────────────────────────────────────────────
# NEVER commit real credentials. Set these in your hosting platform's env variables.
# Path to your downloaded service-account JSON key file (local dev only)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# OR provide inline (for platforms like Railway / Render):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Google Sheets IDs ─────────────────────────────────────────────────────────
# Create one master spreadsheet and add these sheets as tabs.
SHEET_ID=REPLACE_WITH_YOUR_GOOGLE_SHEET_ID

# ── Google Drive Folder IDs ───────────────────────────────────────────────────
DRIVE_FOLDER_PATIENT_DOCS=REPLACE_WITH_FOLDER_ID
DRIVE_FOLDER_PATIENT_IMAGES=REPLACE_WITH_FOLDER_ID
DRIVE_FOLDER_PRESCRIPTIONS=REPLACE_WITH_FOLDER_ID
DRIVE_FOLDER_BEFORE_AFTER=REPLACE_WITH_FOLDER_ID
DRIVE_FOLDER_CLINIC_DOCS=REPLACE_WITH_FOLDER_ID

# ── Demo / Mock mode ─────────────────────────────────────────────────────────
# Set to "true" to use in-memory mock data (no Google account needed for testing)
USE_MOCK_DATA=true
